# ── Login (OPCIONALES) ────────────────────────────────────
# Sin estas variables funciona el acceso incorporado (usuario amola).
# Definirlas reemplaza ese acceso.
# En Netlify: Site configuration → Environment variables.
# En tu PC: copiá este archivo como .env.local para usar el login con `npm run dev`.
# Las lee SOLO el servidor (funciones de Netlify): nunca llegan al navegador.
AUTH_USER=amola
AUTH_PASSWORD=cambiar-esta-clave
# Opcional: firma de sesiones. Si no se define, se deriva de usuario + contraseña.
# AUTH_SECRET=

# ── Fase 1 ──────────────────────────────────────────────
# La Fase 1 funciona 100% en el navegador y NO necesita variables.
# Los datos se guardan en IndexedDB del navegador del usuario.

# ── Fase 2 (IA) — se configuran en el BACKEND (Railway), nunca en el frontend ──
# URL pública del backend que consume el frontend
VITE_API_URL=https://amola-estudio-api.up.railway.app

# Solo backend:
# ANTHROPIC_API_KEY=        # análisis fotográfico + textos comerciales + asistente
# PHOTOROOM_API_KEY=        # recorte de fondo + fondos generados preservando el producto
# MAX_GENERATIONS_PER_DAY=50
# MAX_UPLOAD_MB=15

# ── Fase 4 (persistencia en la nube) ──


# SUPABASE_SERVICE_ROLE_KEY=   # solo backend

